let balance = 1000;
let multiplier = 1.00;
let running = false;
let hasBet = false;
let betAmount = 0;
let crashPoint = 0;
let timer = null;

const balanceEl = document.getElementById("balance");
const multiplierEl = document.getElementById("multiplier");
const planeEl = document.getElementById("plane");
const statusEl = document.getElementById("status");
const betBtn = document.getElementById("betBtn");
const cashoutBtn = document.getElementById("cashoutBtn");
const betInput = document.getElementById("betAmount");

function updateBalance() {
    balanceEl.textContent = balance.toFixed(2);
}

function startRound() {
    if (timer !== null) {
        clearInterval(timer);
        timer = null;
    }

    running = false;
    hasBet = false;
    multiplier = 1.00;

    multiplierEl.textContent = "1.00x";
    planeEl.style.left = "25%";
    planeEl.style.bottom = "70px";
    statusEl.textContent = "ROUND STARTING...";

    betBtn.disabled = false;
    cashoutBtn.disabled = true;

    crashPoint = 1.20 + Math.random() * 5.00;

    setTimeout(function () {
        running = true;
        statusEl.textContent = "FLYING...";
        runGame();
    }, 2000);
}

function runGame() {
    timer = setInterval(function () {
        if (!running) {
            return;
        }

        multiplier += 0.01;
        multiplier = Number(multiplier.toFixed(2));

        multiplierEl.textContent = multiplier.toFixed(2) + "x";

        const progress = Math.min((multiplier - 1) / 5, 1);

        planeEl.style.left = (25 + progress * 65) + "%";
        planeEl.style.bottom = (70 + progress * 180) + "px";

        if (multiplier >= crashPoint) {
            crash();
        }
    }, 100);
}

betBtn.addEventListener("click", function () {
    if (!running) {
        alert("Round अभी शुरू नहीं हुआ है।");
        return;
    }

    if (hasBet) {
        return;
    }

    betAmount = Number(betInput.value);

    if (!Number.isFinite(betAmount) || betAmount <= 0) {
        alert("Bet amount सही डालें।");
        return;
    }

    if (betAmount > balance) {
        alert("Demo balance पर्याप्त नहीं है।");
        return;
    }

    balance -= betAmount;
    updateBalance();

    hasBet = true;
    betBtn.disabled = true;
    cashoutBtn.disabled = false;

    statusEl.textContent = "BET PLACED: ₹" + betAmount.toFixed(2);
});

cashoutBtn.addEventListener("click", function () {
    if (!hasBet || !running) {
        return;
    }

    const winnings = betAmount * multiplier;

    balance += winnings;
    updateBalance();

    statusEl.textContent =
        "CASHED OUT: ₹" + winnings.toFixed(2);

    hasBet = false;
    cashoutBtn.disabled = true;
});

function crash() {
    running = false;

    if (timer !== null) {
        clearInterval(timer);
        timer = null;
    }

    multiplierEl.textContent = multiplier.toFixed(2) + "x";

    statusEl.textContent =
        "CRASHED AT " + multiplier.toFixed(2) + "x";

    hasBet = false;
    cashoutBtn.disabled = true;

    setTimeout(function () {
        startRound();
    }, 3000);
}

updateBalance();
startRound();
