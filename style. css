* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #090b12;
    color: white;
    font-family: Arial, sans-serif;
}

header {
    height: 65px;
    background: #111522;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 18px;
}

.logo {
    font-size: 22px;
    font-weight: bold;
}

.balance {
    font-size: 14px;
    color: #ddd;
}

.game-box {
    margin: 15px;
    height: 380px;

    border-radius: 15px;

    background:
        radial-gradient(circle at center, #24152e, #090b12 70%);

    position: relative;

    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;
}

.multiplier {
    font-size: 52px;
    font-weight: bold;

    color: #fff;

    position: absolute;
    top: 125px;

    z-index: 2;
}

.plane {
    position: absolute;

    left: 25%;
    bottom: 70px;

    font-size: 45px;

    transition: all 0.1s linear;
}

.status {
    position: absolute;
    bottom: 25px;

    color: #aaa;
    font-size: 14px;
}

.controls {
    padding: 15px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 10px;
}

.bet-input {
    grid-column: span 2;
}

.bet-input label {
    display: block;

    margin-bottom: 6px;

    color: #aaa;
}

input {
    width: 100%;

    padding: 14px;

    border: none;
    border-radius: 10px;

    background: #191d29;

    color: white;

    font-size: 18px;
}

button {
    border: none;

    padding: 16px;

    border-radius: 10px;

    color: white;

    font-size: 17px;

    font-weight: bold;

    cursor: pointer;
}

.bet-btn {
    background: #18a957;
}

.cashout-btn {
    background: #d63838;
}

button:disabled {
    opacity: 0.4;
}

.history {
    margin: 10px 15px;

    padding: 15px;

    background: #111522;

    border-radius: 12px;
}

.history h3 {
    margin-bottom: 12px;
}

#historyList {
    display: flex;

    gap: 8px;

    flex-wrap: wrap;
}

#historyList span {
    background: #202535;

    padding: 7px 12px;

    border-radius: 20px;

    color: #ddd;
}